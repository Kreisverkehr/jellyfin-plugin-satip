<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Web\settings.html" />
    <None Remove="Web\settings.js" />
    <EmbeddedResource Include="Web\settings.html" />
    <EmbeddedResource Include="Web\settings.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.1.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Kreisverkehr.NetUpnp" Version="0.1.3" />
    <PackageReference Include="Kreisverkehr.NetSsdp" Version="0.1.3" />
    <PackageReference Include="Kreisverkehr.TsDecoder" Version="4.0.0-beta2" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
  </ItemGroup>

</Project>
